@model IEnumerable<TranNgocKhanh_241230761.Models.HangHoa>

<div class="content_top">
	<div class="heading">
		<h3>Tran Ngoc Khanh</h3>
	</div>
	<div class="see">
		<p><a href="#">See all Products</a></p>
	</div>
	<div class="clear"></div>
</div>

<div class="section group">
    @foreach (var item in Model)
    {
        <div class="grid_1_of_4 images_1_of_4">
            <a href="#"><img src="~/Content/images/@item.Anh" alt="" /></a>
            <h2>@item.TenHang</h2>
            <div class="price-details">
                <div class="price-number">
                    <p><span class="rupees">@(item.Gia?.ToString("0"))</span></p>
                </div>
                <div class="add-cart">
                    <h4><a href="#">Add to Cart</a></h4>
                </div>
                <div class="clear"></div>
            </div>
        </div>
    }
</div>